{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteRawCaptures",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::YOUR-BUCKET/raw/*"
    },
    {
      "Sid": "Heartbeat",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {"StringEquals": {"cloudwatch:namespace": "Ecobici"}}
    }
  ]
}
