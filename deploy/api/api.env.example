# Copied to /etc/ecobici/api.env by setup.sh. Edit every value.
S3_BUCKET_NAME=YOUR-BUCKET
ECOBICI_FEEDBACK_SINK=s3://YOUR-BUCKET/feedback
# Without this line, the API saves no plans.
ECOBICI_PLAN_SINK=s3://YOUR-BUCKET/plans
# /admin shows the plans and the feedback. Caddy must protect it (Caddyfile).
ECOBICI_ADMIN=on
# Exact origin of the web app, without a trailing slash. Separate more origins with commas.
ECOBICI_API_ORIGINS=https://YOUR-VERCEL-DOMAIN
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR-KEY-ID
AWS_SECRET_ACCESS_KEY=YOUR-SECRET
